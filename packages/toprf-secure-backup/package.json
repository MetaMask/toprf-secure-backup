{
  "name": "@metamask/toprf-secure-backup",
  "version": "0.3.2",
  "description": "The MetaMask Node module template",
  "keywords": [
    "MetaMask",
    "Ethereum"
  ],
  "homepage": "https://github.com/MetaMask/toprf-secure-backup/tree/main/packages/toprf-secure-backup#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/toprf-secure-backup/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/toprf-secure-backup.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "ts-bridge --project tsconfig.build.json --verbose --clean --no-references",
    "build:docs": "typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/toprf-secure-backup",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/toprf-secure-backup",
    "publish:preview": "yarn npm publish --tag preview",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --reporters=jest-silent-reporter",
    "test:clean": "NODE_OPTIONS=--experimental-vm-modules jest --clearCache",
    "test:verbose": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "dependencies": {
    "@metamask/auth-network-utils": "^0.3.0",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@sentry/core": "^9.10.0",
    "@toruslabs/constants": "^15.0.0",
    "@toruslabs/eccrypto": "^6.1.0",
    "@toruslabs/fetch-node-details": "^15.0.0",
    "@toruslabs/http-helpers": "^8.1.1",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@babel/runtime": "^7.26.10",
    "@metamask/auto-changelog": "^3.4.4",
    "@types/bn.js": "^5.1.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node-fetch": "2",
    "deepmerge": "^4.2.2",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "2",
    "ts-jest": "^29.3.0",
    "typedoc": "^0.24.8",
    "typedoc-plugin-missing-exports": "^2.0.0",
    "typescript": "~5.2.2"
  },
  "engines": {
    "node": "^18.18 || >=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
